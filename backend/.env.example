# Backend environment variables
# Copy this file to .env and fill in values

# JSON list of allowed CORS origins
ALLOWED_ORIGINS=["http://localhost:5173"]

# App environment: development | staging | production
APP_ENV=development

# Secret key for JWT signing — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# JWT algorithm
ALGORITHM=HS256

# Access token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLite for local dev (PostgreSQL-ready — swap DATABASE_URL for postgres+asyncpg:// in prod)
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Future PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname

# ── Admin bootstrap ───────────────────────────────────────────────────────────
# There is no public endpoint to create admin users. Use the bootstrap script once:
# Apply migrations first with: alembic upgrade head
#
#   ADMIN_EMAIL=you@example.com \
#   ADMIN_PASSWORD=yourpassword \
#   ADMIN_NAME="Your Name" \
#   python -m app.scripts.create_admin
#
# To promote an existing client account:
#   ADMIN_PROMOTE_EXISTING=true \
#   ADMIN_EMAIL=existing@example.com \
#   ADMIN_PASSWORD=existingpassword \
#   ADMIN_NAME="Your Name" \
#   python -m app.scripts.create_admin
